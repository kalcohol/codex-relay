      "baseUrlOriginal": "https://api.deepseek.com/",
      "envKey": "DEEPSEEK_API_KEY"
    },
    {
      "name": "glm",
      "port": 18782,
      "upstream": "https://open.bigmodel.cn",
      "codexHome": "~/.codex-glm",
      "baseUrlAfter": "http://127.0.0.1:18782/api/v1",
      "baseUrlOriginal": "https://open.bigmodel.cn/api/v1",
      "envKey": "GLM_API_KEY",
      "catalogNeedsV2": true
    },
    {
      "name": "kimi",
      "port": 18783,
      "upstream": "https://api.kimi.com",
      "codexHome": "~/.codex-kimi",
      "baseUrlAfter": "http://127.0.0.1:18783/coding/v1",
      "baseUrlOriginal": "https://api.kimi.com/coding/v1",
      "envKey": "KIMI_API_KEY"
    }
